# Copie para .env (nunca commitar o .env).

# Postgres (compartilhado com o time; dono do schema: Ahmed)
POSTGRES_USER=scanner
POSTGRES_PASSWORD=troque-me
POSTGRES_DB=scanner
DATABASE_URL=postgresql+psycopg://scanner:troque-me@postgres:5432/scanner

# Redis Streams (fila entre etapas)
REDIS_URL=redis://redis:6379/0

# ZAP (API só na rede interna)
ZAP_API_KEY=troque-me-por-um-valor-aleatorio
ZAP_API_URL=http://zap:8080
ZAP_JVM_XMX=6g

# Limites de scan (regra "não causar dano")
SCAN_MAX_DURATION_MINUTES=60
SCAN_THREADS_PER_HOST=2
SCAN_MAX_REQUESTS_PER_SECOND=10
# Limites de laboratório (soltos; só quando todo o escopo é de laboratório)
SCAN_LAB_MAX_DURATION_MINUTES=60
SCAN_LAB_THREADS_PER_HOST=10
SCAN_LAB_MAX_REQUESTS_PER_SECOND=100
# Recursos do ZAP (ajuste à sua máquina)
ZAP_CPUS=6
ZAP_MEM_LIMIT=8g

# Claude API (etapa 6)
# LLM da etapa 6 (remediação). LLM_PROVIDER: none (só catálogo) | anthropic | openai_compatible.
# MVP gratuito com Groq: LLM_PROVIDER=openai_compatible, LLM_BASE_URL=https://api.groq.com/openai/v1,
# LLM_MODEL=llama-3.3-70b-versatile, LLM_API_KEY=<chave gratuita do console.groq.com>.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=high

# Fontes exigidas antes do relatório (JSON). Provisório até combinar com a etapa 3.
REPORT_REQUIRED_TOOLS=["zap","nuclei"]

# Interface web
# Segredo que assina o cookie de sessão (mínimo 32 caracteres): openssl rand -hex 32
WEB_SESSION_SECRET=
# true em produção (HTTPS). false só para desenvolvimento local em http://localhost:8000
WEB_SECURE_COOKIES=true

# Logs
LOG_LEVEL=INFO
